{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spot-light",
  "compatibility_date": "2026-09-13",
  "assets": {
    "directory": "./dist"
  },
  "routes": [
    {
      "pattern": "spot.ysnets.org",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
  },
